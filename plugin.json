{
  "id": "apple-music",
  "name": "Apple Music",
  "version": "1.1.0",
  "minAppVersion": "0.1.8",
  "main": "dist/index.js",
  "playback": "remote",
  "permissions": {
    "network": [
      "amp-api.music.apple.com",
      "amp-api-edge.music.apple.com",
      "music.apple.com",
      "beta.music.apple.com",
      "*.music.apple.com",
      "play.itunes.apple.com",
      "itunes.apple.com",
      "audio-ssl.itunes.apple.com",
      "*.itunes.apple.com",
      "*.mzstatic.com",
      "lrclib.net"
    ],
    "process": [
      "bin/apple-music-core-*"
    ]
  },
  "requestHeaders": [
    {
      "hosts": [
        "amp-api.music.apple.com",
        "amp-api-edge.music.apple.com"
      ],
      "headers": {
        "Origin": "https://music.apple.com",
        "Referer": "https://music.apple.com/"
      }
    },
    {
      "hosts": [
        "*.mzstatic.com"
      ],
      "kinds": [
        "image"
      ],
      "headers": {
        "Referer": "https://music.apple.com/"
      }
    }
  ],
  "settings": [
    {
      "key": "storefront",
      "label": "Storefront Region",
      "help": "Two-letter country code (e.g. us, cn, jp, gb)"
    },
    {
      "key": "displayName",
      "label": "Display Name (Optional)",
      "help": "Custom name shown in greeting and sidebar if your Apple Music profile has no nickname."
    },
    {
      "key": "audioQuality",
      "label": "Apple Music Playback Quality",
      "type": "select",
      "options": [
        { "value": "", "label": "Highest available lossless (default)" },
        { "value": "lossless", "label": "Lossless (up to 48 kHz)" },
        { "value": "aac", "label": "High Quality (AAC 256 kbps)" }
      ],
      "help": "Applies to Apple Music from the next song. AAC uses less data; lossless uses ALAC."
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Browse",
      "page": "browse",
      "icon": "star"
    },
    {
      "builtin": "stations"
    },
    {
      "title": "Recently Played",
      "page": "recent",
      "icon": "calendar"
    },
    {
      "builtin": "liked"
    },
    {
      "builtin": "savedAlbums"
    }
  ]
}
